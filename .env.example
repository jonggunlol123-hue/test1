NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/goldmoon
# 운영 환경에서는 32자 이상의 무작위 값으로 설정하세요.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# 최초 배포 시 설정할 초기 관리자 계정. 기존 계정의 비밀번호를 덮어쓰지 않습니다.
ADMIN_USERNAME=boss
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ADMIN_DISPLAY_NAME=조직 두목
# 선택: RESET_ADMIN_USERNAME 및 RESET_ADMIN_PASSWORD를 설정하고 npm run admin:reset 실행
# RESET_ADMIN_USERNAME=boss
# RESET_ADMIN_PASSWORD=replace-with-a-new-unique-password
# 로컬 PostgreSQL 연결 시 SSL을 비활성화하려면 PGSSL=disable
PGSSL=disable
